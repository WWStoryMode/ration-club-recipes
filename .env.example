# Copy to .env and adjust. .env is gitignored. Never put real secrets in this file.
DOCSPLUS_MCP_URL=https://prodback.docs.plus/api/mcp
# Doc the app reads/edits. Default: our fictional TEST doc (pnpm create-test-doc).
# The real booklet is tt9qajlqe47; only switch to it once `pnpm check` says OWNER: yes.
DOC_SLUG=ration-club-recipes-test-doc-fictional-data
OAUTH_REDIRECT_PORT=8787
# file (local dev, writes to SECRETS_DIR) | redis (later phase)
TOKEN_STORE=file
SECRETS_DIR=.secrets
# Later phase (Upstash):
# UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<placeholder>

# Server (one instance only; SECRETS_DIR must be on a persistent disk)
HOST=127.0.0.1
PORT=3000
# One-time import of a login made with `SECRETS_DIR=.secrets-server pnpm run login` + `pnpm export-login`.
# Only imported into an EMPTY SECRETS_DIR. Delete it from the host after the first successful start.
DOCSPLUS_LOGIN_BUNDLE=

# --- Protection (Phase 4a) ---
# Audit log + salt. On the host: a folder on the persistent disk, e.g. /data/audit
DATA_DIR=.data
# Optional fixed salt for IP hashes (otherwise generated once into DATA_DIR/audit-salt)
AUDIT_SALT=
# Header your host sets with the visitor IP: fly-client-ip (Fly), x-forwarded-for (Railway/Render). Empty locally.
CLIENT_IP_HEADER=
# Cloudflare Turnstile. REQUIRED when NODE_ENV=production (or set TURNSTILE_DISABLED=1).
# Test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
TURNSTILE_DISABLED=
# Rate limits as count/seconds
RATE_WRITES_PER_IP=10/600
RATE_READS_PER_IP=120/60
RATE_WRITES_GLOBAL=30/60
