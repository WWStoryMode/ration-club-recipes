# Copy to .env and adjust. .env is gitignored. Never put real secrets in this file.
DOCSPLUS_MCP_URL=https://prodback.docs.plus/api/mcp
# Doc the app reads/edits. Default: our fictional TEST doc (pnpm create-test-doc).
# The real booklet is tt9qajlqe47; only switch to it once `pnpm check` says OWNER: yes.
DOC_SLUG=ration-club-recipes-test-doc-fictional-data
OAUTH_REDIRECT_PORT=8787
# file (local dev, writes to SECRETS_DIR) | redis (later phase)
TOKEN_STORE=file
SECRETS_DIR=.secrets
# Later phase (Upstash):
# UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<placeholder>
