{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "login": "tsx --env-file-if-exists=../.env src/scripts/login.ts",
    "export-login": "tsx --env-file-if-exists=../.env src/scripts/exportLogin.ts",
    "audit-log": "tsx --env-file-if-exists=../.env src/scripts/auditLog.ts",
    "queue": "tsx --env-file-if-exists=../.env src/scripts/queue.ts",
    "check": "tsx --env-file-if-exists=../.env src/scripts/check.ts",
    "token-info": "tsx --env-file-if-exists=../.env src/scripts/tokenInfo.ts",
    "create-test-doc": "tsx --env-file-if-exists=../.env src/scripts/createTestDoc.ts",
    "capture-fixtures": "tsx --env-file-if-exists=../.env src/scripts/captureFixtures.ts",
    "write-test": "tsx --env-file-if-exists=../.env src/scripts/writeTest.ts",
    "format-test": "tsx --env-file-if-exists=../.env src/scripts/formatTest.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "^4.11.4",
    "open": "^10.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
