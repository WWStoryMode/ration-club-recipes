{
  "name": "ration-club-recipes",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "prepare": "husky",
    "dev:server": "pnpm --filter server run dev",
    "dev:web": "pnpm --filter web run dev",
    "login": "pnpm --filter server run login",
    "export-login": "pnpm --filter server run export-login",
    "audit-log": "pnpm --filter server run audit-log",
    "check": "pnpm --filter server run check",
    "token-info": "pnpm --filter server run token-info",
    "create-test-doc": "pnpm --filter server run create-test-doc",
    "capture-fixtures": "pnpm --filter server run capture-fixtures",
    "write-test": "pnpm --filter server run write-test",
    "format-test": "pnpm --filter server run format-test",
    "test": "pnpm --filter server run test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
